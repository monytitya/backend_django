SECRET_KEY=docker-dev-secret-key-change-in-production-123456789
DEBUG=True

# PostgreSQL (matches docker-compose.yml)
RDS_DB_NAME=greatkart
RDS_USERNAME=greatkart_user
RDS_PASSWORD=greatkart_pass
RDS_HOSTNAME=db
RDS_PORT=5432

# Email (update with real credentials if you want email to work)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True

# AWS S3 (leave as dummy for local/docker dev - we use local static)
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_STORAGE_BUCKET_NAME=dummy

